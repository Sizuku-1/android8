<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page"
    android:defaultFocusHighlightEnabled="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper"
    android:focusableInTouchMode="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_weather"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/identity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:gravity="center_vertical"
            android:layout_weight="1"
            android:paddingStart="9dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:id="@+id/heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/city_heading"
            android:textSize="32sp"
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />
        <EditText
            android:id="@+id/search"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:inputType="text"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:background="@drawable/field"
            android:paddingHorizontal="16dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="9dp"
            android:hint="@string/search_hint"
            android:textColorHint="@color/muted"
            android:textColor="@color/ink"
            android:textSize="16sp" />
        <LinearLayout
            android:id="@+id/favorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="17dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/favorites"
                android:textSize="14sp"
                android:textColor="@color/muted"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/chengdu"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/pill"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:text="@string/chengdu"
                    android:textColor="@color/teal"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/beijing"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/pill"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:text="@string/beijing"
                    android:textColor="@color/teal"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/tianjin"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/pill"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:text="@string/tianjin"
                    android:textColor="@color/teal"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading_cities"
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:textStyle="bold" />
    </LinearLayout>
    <ListView
        android:id="@+id/cities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:divider="@color/line"
        android:dividerHeight="1dp" />
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/muted"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />
</LinearLayout>
